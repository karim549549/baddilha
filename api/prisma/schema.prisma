// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  profilePicture String?
  bio           String?
  latitude      Float?
  longitude     Float?
  gamingInterests GamingInterest[] @default([])
  preferredPlatforms GamingPlatform[] @default([])
  emailVerified Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  items         Item[]
  likesGiven    Like[] @relation("LikesGiven")
  sentMessages  Message[] @relation("SentMessages")
  preferences   UserPreferences?
  matchesInitiated Match[] @relation("MatchesInitiated")
  matchesReceived Match[] @relation("MatchesReceived")
  accounts      Account[]
  passkeys      Passkey[]
}

model Passkey {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey         String  @unique
  transports        String? // Comma-separated list of transports (e.g., "internal,hybrid")
  counter           Int
  credentialID      String  @unique
  credentialBackedUp Boolean @default(false)
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime? @updatedAt
}

model UserPreferences {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
  maxSwapDistanceKm   Int       @default(80)
  preferredItemCategories String[] @default([])
  preferredConditions String[] @default([])
  preferredGameTitles String[] @default([])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Item {
  id              String    @id @default(uuid())
  name            String
  description     String?
  condition       ItemCondition
  photos          String[]
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id])
  category        ItemCategory
  status          String    @default("Available")
  likesCount      Int @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  likesReceived   Like[] @relation("LikesReceived")
  matchesAsUser1Item Match[] @relation("ItemForUser1")
  matchesAsUser2Item Match[] @relation("ItemForUser2")
}

model Like {
  id        String   @id @default(uuid())
  likerId   String
  liker     User     @relation("LikesGiven", fields: [likerId], references: [id])
  likedItemId String
  likedItem Item     @relation("LikesReceived", fields: [likedItemId], references: [id])
  createdAt DateTime @default(now())

  @@unique([likerId, likedItemId])
}

model Match { // Renamed from Swap
  id            String    @id @default(uuid())
  user1Id       String // User who initiated the like that led to the match
  user1         User      @relation("MatchesInitiated", fields: [user1Id], references: [id])
  user2Id       String // User who reciprocated the like
  user2         User      @relation("MatchesReceived", fields: [user2Id], references: [id])
  user1ItemId   String // Item user1 offered
  user1Item     Item      @relation("ItemForUser1", fields: [user1ItemId], references: [id])
  user2ItemId   String // Item user2 offered
  user2Item     Item      @relation("ItemForUser2", fields: [user2ItemId], references: [id])
  status        MatchStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  messages      Message[]
}

model Message {
  id        String   @id @default(uuid())
  matchId    String // Renamed from swapId
  match      Match     @relation(fields: [matchId], references: [id]) // Renamed from swap
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ItemCategory {
  CONSOLE
  PC_PART
  ACCESSORY
  GAME
  OTHER
}

enum MatchStatus { // Renamed from SwapStatus
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum GamingInterest {
  ACTION
  ADVENTURE
  RPG
  STRATEGY
  SPORTS
  SIMULATION
  FIGHTING
  RACING
  PUZZLE
  HORROR
  OPEN_WORLD
  // Add more as needed
}

enum GamingPlatform {
  PC
  PLAYSTATION
  XBOX
  NINTENDO_SWITCH
  MOBILE
  RETRO_CONSOLE
  // Add more as needed
}